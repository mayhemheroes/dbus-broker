# syntax=docker/dockerfile:1.7
#
# Commit-image Dockerfile (SMALL form) — builds ON TOP of the org C/C++ base image
# (ghcr.io/mayhemheroes/base). The base provides debian + clang/llvm + libFuzzer/afl++ + the
# identities + the build-contract ENV; this adds the per-commit dbus-broker build.
#
# Build (from the repo root):
#   DOCKER_BUILDKIT=1 docker build -f mayhem/Dockerfile \
#       --build-arg COMMIT=$(git rev-parse HEAD) \
#       [--build-arg SOURCE_DATE_EPOCH=$(date +%s)] \
#       -t dbus-broker-commit:test .

FROM ghcr.io/mayhemheroes/base:20260621

ARG COMMIT
ARG REPO_URL
# SOURCE_DATE_EPOCH stays an ARG (available to build.sh); never bake it as ENV — an empty value
# breaks clang. build.sh unsets it when empty.
ARG SOURCE_DATE_EPOCH

# Sanitizer override: the base exports SANITIZER_FLAGS (ASan+UBSan, halting) as the default.
# Declare it WITHOUT a default so an unset arg lets the base ENV flow through; --build-arg overrides.
ARG SANITIZER_FLAGS
ARG MAYHEM_JOBS=

# dbus-broker builds with meson+ninja; its c-util libs and Rust FFI glue are meson git-wrap
# subprojects, and libbus's Rust bindings are generated by bindgen — so the build needs
# meson, rustc, cargo, bindgen, pkg-config, jq (libc-rs wrap uses it), git + ca-certificates
# (meson clones the wraps). ninja/clang/git ship in the base; add the rest as root, then drop back.
USER root
RUN [ -n "$SOURCE_DATE_EPOCH" ] && repro-sources-list.sh || true; \
    apt-get update && apt-get install -yq --no-install-recommends \
      meson ninja-build pkg-config bindgen jq ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

# dbus-broker's `sys-1` meson wrap (bus1/sys @ v1, a moving branch) now requires Rust >= 1.91 —
# newer than Debian's apt `rustc` (1.85), which fails the meson build. Install a PINNED rustup
# toolchain into a shared, world-readable /opt/toolchains/rust; RUSTUP_HOME + PATH let the mayhem-user build
# (meson drives rustc directly) find it, while cargo still writes its caches to the per-user
# $HOME/.cargo. Pinned version = reproducible; the download happens in this build layer only.
ENV RUSTUP_HOME=/opt/toolchains/rust PATH=/opt/toolchains/rust/bin:$PATH
RUN curl -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh && \
    CARGO_HOME=/opt/toolchains/rust sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal \
      --default-toolchain 1.91.0 && \
    rm -f /tmp/rustup-init.sh && chmod -R a+rX /opt/toolchains/rust && rustc --version
USER mayhem

# Source enters from the build CONTEXT (the CI checkout): the FULL repo (incl. .git history)
# is copied to /mayhem as `mayhem`; build.sh builds in place.
WORKDIR /mayhem
COPY --chown=2000:2000 . /mayhem

RUN bash mayhem/build.sh

# Run dbus-broker's unit suite at build time (a failing suite fails the image build).
RUN if [ -f mayhem/test.sh ]; then bash mayhem/test.sh; else echo "no mayhem/test.sh"; fi

LABEL org.opencontainers.image.source="${REPO_URL}" \
      org.opencontainers.image.revision="${COMMIT}" \
      rlenv.tier="commit" \
      rlenv.source_date_epoch="${SOURCE_DATE_EPOCH}" \
      rlenv.user="mayhem"

USER mayhem
WORKDIR /mayhem
